{
  "name": "@veksa/re-reselect",
  "version": "5.1.6",
  "description": "Enhance Reselect selectors with deeper memoization and cache management",
  "main": "dist/cjs/index.js",
  "module": "dist/es/index.mjs",
  "jsnext:main": "dist/es/index.mjs",
  "browser": "dist/umd/index.umd.js",
  "types": "dist/es/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/es/index.d.ts",
      "import": "./dist/es/index.mjs",
      "default": "./dist/cjs/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "yarn clean && tsdown",
    "test": "vitest --config ./vitest.config.mts",
    "test:bundles": "yarn test:bundles:snapshot && yarn test:bundles:unit && yarn test:bundles:runtime",
    "test:bundles:unit": "vitest run --config ./test-bundles/cjs.vitest.config.mts && vitest run --config ./test-bundles/es.vitest.config.mts && vitest run --config ./test-bundles/umd.vitest.config.mts",
    "test:bundles:snapshot": "vitest run bundles-snapshot.test.ts --dir ./test-bundles --coverage.enabled false",
    "test:bundles:runtime": "vitest run umd-runtime.test.ts --dir ./test-bundles --coverage.enabled false",
    "prepare": "npx simple-git-hooks",
    "verify": "yarn source:check && yarn test --run && yarn build && yarn test:bundles",
    "release": "yarn verify && npx changeset publish",
    "prettier:check": "prettier . --check",
    "prettier:fix": "yarn prettier:check --write",
    "type:check": "tsc --noEmit",
    "source:check": "yarn prettier:check && yarn type:check",
    "source:fix": "yarn prettier:fix",
    "bench": "yarn build && node --expose-gc bench/run.mjs"
  },
  "keywords": [
    "react",
    "redux",
    "reselect",
    "memoize",
    "cache"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toomuchdesign/re-reselect.git"
  },
  "author": "Andrea Carraro <me@andreacarraro.it>",
  "license": "MIT",
  "peerDependencies": {
    "@veksa/reselect": "^5.2.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.1.1",
    "@veksa/reselect": "^5.2.2",
    "@vitest/coverage-v8": "^4.1.10",
    "expect-type": "^1.4.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "yarn verify"
  },
  "packageManager": "yarn@4.18.0"
}
